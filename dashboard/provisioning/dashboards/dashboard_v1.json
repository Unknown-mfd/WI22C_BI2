        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  UNIX_TIMESTAMP(dd.full_datetime)*1000 AS time,\r\n  p.name                             AS metric,\r\n  AVG(t.trend_score)                 AS value\r\nFROM Dim_Trend t\r\nJOIN Dim_Datum_Full dd ON t.datum_id   = dd.datum_id\r\nJOIN Dim_Produkt    p  ON t.produkt_id = p.produkt_id\r\nWHERE\r\n  $__timeFilter(dd.full_datetime)\r\n  AND ('Alle' IN ($laptop) OR p.name IN ($laptop))\r\n  AND t.region = 'DE'\r\nGROUP BY 1, p.name\r\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Trendverlauf für $laptop",
      "type": "timeseries"
